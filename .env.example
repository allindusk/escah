# LLM 翻译配置（OpenAI 兼容接口），默认 Kimi（Moonshot AI）
# 申请 Key：https://platform.moonshot.cn/ 注册后在「API Key 管理」创建
# 复制本文件为 .env 并填入你的 Key（.env 已被 gitignore，不会提交）
LLM_API_KEY=
LLM_BASE_URL=https://api.moonshot.cn/v1
LLM_MODEL=moonshot-v1-8k

# 每个请求最多携带的文本块数；失败重试次数
LLM_BATCH_SIZE=20
LLM_MAX_RETRIES=3

# ===== 谷歌翻译接口（机翻已停用：仅在 update --gtrans 或手动 gtrans 时需要）=====
# 取值优先级：环境变量 GOOGLE_API_KEY → .env 的 GOOGLE_API_KEY → .env 的
# GOOGLE_API_KEY_ENC（密文）+ ESCAH_SECRET_KEY（主口令）解密。
# ⚠️ 千万不要把真实 key 写回代码或任何入库文件（2026-11-13 曾因硬编码被 GitHub 报警）。
GOOGLE_API_KEY=

# 密文主口令：只想在配置里存密文时使用（生成密文：python -m escah_pipeline.secrets encrypt <key>）
ESCAH_SECRET_KEY=

# 原站抓取可选：Cloudflare 验证通过后的 Cookie（CI 里用 Secrets 注入，不写这里）
# WIKIRU_COOKIE=
