# LLM 翻译配置（OpenAI 兼容接口），默认 Kimi（Moonshot AI）
# 申请 Key：https://platform.moonshot.cn/ 注册后在「API Key 管理」创建
# 复制本文件为 .env 并填入你的 Key（.env 已被 gitignore，不会提交）
LLM_API_KEY=
LLM_BASE_URL=https://api.moonshot.cn/v1
LLM_MODEL=moonshot-v1-8k

# 每个请求最多携带的文本块数；失败重试次数
LLM_BATCH_SIZE=20
LLM_MAX_RETRIES=3

# 清理临时文件，更新文档，更新版本，更新更新记录文档，提交推送
