 },
 "key40": {
  "ja": "\n衝撃のあるベルトと効果が重複する。",
  "zh": "与冲击腰带效果重复。"
 },
 "key41": {
  "ja": "レイドバトルでは、魔法アタッカーの基本装備は",
  "zh": ""
 },
 "key42": {
  "ja": "しゃーべりタイガー",
  "zh": "咆哮猛虎"
 },
 "key43": {
