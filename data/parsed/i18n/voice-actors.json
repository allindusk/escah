 },
 "key418": {
  "ja": "声優さんの数が多くなって検索し辛かったので、五十音順（頭文字）に変更してみました。リンクがおかしくなっていたり、消えているところがあったら指摘お願いします。",
  "zh": "因为声优人数变多导致搜索困难，所以试着改成了按五十音顺（首字母）排列。如果发现链接异常或缺失之处，请指正。"
 },
 "key419": {
  "ja": "2022-12-03 (土) 22:02:18",
  "zh": "2022-12-03 (周六) 22:02:18"
 },
 "key420": {
  "ja": "些細なことだけどブライド・ニルのリンク先間違ってるぜ",
  "zh": "虽然是个小问题，但花嫁·尼尔的链接目标搞错了哦"
 },
