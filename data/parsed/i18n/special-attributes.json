 "key16": {
  "ja": "特殊属性確認画面",
  "zh": "特殊属性确认画面"
 },
 "key17": {
  "ja": "キャラクター強化→表示変更→特殊属性、またはキャラの個別のステータス画面でSDキャラの右側で確認できる「特殊属性」の一覧です。",
  "zh": "角色强化→显示变更→特殊属性，或者在角色的个别状态画面SD角色的右侧可以确认的“特殊属性”一览。"
 },
 "key18": {
  "ja": "\nキャラクター強化→並び替え→絞り込み設定 から絞り込み可能です。",
  "zh": "角色强化→排序→从筛选设置中可以进行筛选。"
 },
 "key19": {
  "ja": "現在は超昂装備の装備条件に「超昂フェス」が影響しています。また",
  "zh": ""
 },
 "key20": {
  "ja": "聖剣コスモス",
  "zh": "圣剑科斯莫斯"
 },
 "key21": {
  "ja": "が「装備者は全ての所属、特殊属性を持つ。」という能力を持っています。",
  "zh": ""
 },
