 "_blocks": {
  "blk1": {
   "keys": [
    "key10",
    "key11",
    "key12"
   ],
   "ja": "物理攻撃ダメージ軽減。\u0001※「長髪まねき猫」とは違って、\u0001敵に狙われ易くなる要素はない。",
   "zh": "物理攻击伤害减轻。\u0001※与「长发招财猫」不同，\u0001没有更容易被敌人瞄准的因素。"
  },
  "blk2": {
   "keys": [
    "key14",
    "key15",
    "key16"
   ],
   "ja": "牛柄ビキニ鎧姿の肉襦袢。\u0001爆乳がダメージ軽減に寄与している事は、\u0001疑う余地もないだろう。",
   "zh": "牛纹比基尼铠甲姿态的襦袢。\u0001爆乳对减伤有贡献，\u0001这一点毫无怀疑的余地吧。"
  },
  "blk3": {
   "keys": [
    "key27",
    "key28",
    "key29",
    "key30",
    "key31",
    "key32",
    "key33",
    "key34",
    "key35",
    "key36",
    "key37",
    "key38",
    "key39"
   ],
   "ja": "物理ダメージを軽減するタンク（盾役）に有力な装備。\u0001 長髪まねき猫の効果と加算されるためタンクをさらに落ちにくくすることが出来る。\u0001 タンク装備はヘイト維持が最優先なのでロケット(タイガー)やコンボの謎も欲しく、牛女肉襦袢を装備させるとしたら装備枠は3枠目になる。\u0001 そもそも重ねて軽減を狙うのならば逸品のまねき猫の方が良い場合が多い。\u0001 いっそ軽減系で３枠埋めてサブ枠の身代わりの樹ⅡRank5でかばうというのも手だが。",
   "zh": "对减轻物理伤害的重装（盾役）是有力的装备。\u0001 因与长发招财猫的效果相加，可让盾役更难被击倒。\u0001 盾役装备最优先维持仇恨，所以也想要火箭(虎)或连击的谜之效果，若要装备牛女襦袢，装备栏会是第3栏。\u0001 本来若叠加减伤，多数情况下用逸品招财猫更好。\u0001 不如索性用减伤系填满3栏，再用副栏的替身之树ⅡRank5来掩护，这也是一种办法。"
  },
  "blk4": {
   "keys": [
    "key41",
    "key42",
    "key43",
    "key44",
    "key45",
    "key46",
    "key47",
    "key48",
    "key49"
   ],
   "ja": "ヘイトを集める効果がないため、回復役に使えなくもないがロケット(タイガー)やガッツが優先されるので、装備させるとしたら3枠目になる。\u0001 ただ、3枠目も納豆という強力なライバルが居る為微妙。",
   "zh": "因为没有集仇恨的效果，给回复役用也不是不行，但火箭(虎)或斗志优先，所以要装备也是第3栏。\u0001 不过第3栏也有纳豆这个强力竞争对手，所以微妙。"
  },
  "blk5": {
   "keys": [
    "key51",
    "key52"
   ],
   "ja": "Bユニバースでは物理ダメージ軽減装備を付けないとまともに戦えないステージもあるため、これまでの微妙な評価から一変、攻略の仕方によってはキーアイテムとなり得る。",
   "zh": "在B宇宙中，也有不装物理减伤装备就打不了的阶段，因此从此前微妙的评价一变，依攻略方式可成为关键道具。"
  },
  "blk6": {
   "keys": [
    "key55",
    "key56"
   ],
   "ja": "神騎アルデバランを模している",
   "zh": "模仿神骑阿尔德巴兰"
  },
  "blk7": {
   "keys": [
    "key61",
    "key62"
   ],
   "ja": "コメントはありません。 コメント/牛女肉襦袢",
   "zh": "没有评论。 评论/牛女襦袢"
  }
 },
