 "key138": {
  "ja": "ノロイ総力戦  ",
  "zh": "诺洛伊全面战争"
 },
 "key139": {
  "ja": "難易度NORMALの第2部Area18-12をクリアしてメインストーリー第2部「9章7話」を閲覧することで、ノロイ総力戦が解放される。",
  "zh": ""
 },
 "key140": {
  "ja": "\nメインストーリーを読まずに進んできたプレイヤーは、読まなければ進行することが出来ない。",
  "zh": ""
 },
 "key141": {
  "ja": "\n第1部Area36における",
  "zh": ""
 },
 "key142": {
  "ja": "閂市防衛戦",
  "zh": ""
 },
 "key143": {
  "ja": "や第1部Area38の",
  "zh": ""
 },
 "key144": {
  "ja": "最終決戦",
  "zh": ""
 },
 "key145": {
  "ja": "と同様のレイドバトル形式。",
  "zh": ""
 },
 "key146": {
  "ja": "\nノロイ総力戦も過去の同様の戦闘と同じく",
  "zh": ""
 },
 "key147": {
  "ja": "難易度NORMAL限定となっておりHARD、EXTRAでは最終決戦は発生しない。",
  "zh": ""
 },
 "key148": {
  "ja": "\nレイドイベントとの違いは",
  "zh": ""
 },
 "key149": {
  "ja": "1回の挑戦にレイド蛍ではなくスタミナを消費すること\n",
  "zh": "每次尝试消耗体力而不是袭击萤火虫。"
 },
 "key150": {
  "ja": "スタミナ消費半減キャンペーン中でも消費量は変化なし",
  "zh": "即使在减少体力消耗的活动期间，体力消耗也保持不变。"
 },
 "key151": {
  "ja": "出撃可能人数が３０人",
  "zh": "可部署人数：30"
 },
 "key152": {
  "ja": "助っ人の使用が可能",
  "zh": "你可以使用辅助函数。"
 },
 "key153": {
  "ja": "戦闘回数に応じて有利な効果が付与される\n",
  "zh": "根据战斗次数给予有利效果。"
 },
 "key154": {
  "ja": "戦闘回数",
  "zh": "战役数量"
 },
 "key155": {
  "ja": "効果",
  "zh": "效应"
 },
 "key156": {
  "ja": "3戦目以降",
  "zh": "从第三场比赛开始"
 },
 "key157": {
  "ja": "FEVERゲージ増加量UP",
  "zh": "FEVER 指标增益增加"
 },
 "key158": {
  "ja": "5戦目以降",
  "zh": "从第五局开始"
 },
 "key159": {
  "ja": "戦闘開始時FEVERゲージ最大",
  "zh": "战斗开始时狂热槽已满"
 },
 "key160": {
  "ja": "7戦目以降",
  "zh": "从第7局开始"
 },
 "key161": {
  "ja": "更にFEVERゲージ増加量UP",
  "zh": "进一步增加 FEVER 计量量"
 },
 "key162": {
  "ja": "10戦目以降",
  "zh": "从第10局开始"
 },
 "key163": {
  "ja": "BREAKランプ最大値-2",
  "zh": "断路器灯最大值 - 2"
 },
 "key164": {
  "ja": "詳細は",
  "zh": ""
 },
 "key165": {
  "ja": "レイド",
  "zh": ""
 },
 "key166": {
  "ja": "へ。",
  "zh": ""
 },
 "key167": {
  "ja": "\nスペシャル助っ人に「",
  "zh": ""
 },
 "key168": {
  "ja": "超昂閃忍ハルカ",
  "zh": ""
 },
 "key169": {
  "ja": "超昂閃忍スバル",
  "zh": ""
 },
 "key170": {
  "ja": "超昂閃忍ナリカ",
  "zh": ""
 },
 "key171": {
  "ja": "」の3体(自身のプレイヤーLVと同じLVの☆3)を借りることができる。",
  "zh": ""
 },
 "key172": {
  "ja": "\nスーパードリルLV.3、衝撃のあるベルトLV.3、縛り亀甲、ハニージッポを装備しているので、戦闘不能になると全快するオマケまでついている。",
  "zh": ""
 },
 "key173": {
  "ja": "ノロイ総力戦をクリアするとメインストーリー第2部「9章8話」の再生が可能になる。",
  "zh": "通关诺洛伊全面战争后，即可解锁重玩主线剧情第 2 部分第 9 章第 8 集的能力。"
 },
 "key174": {
  "ja": "ボス名",
  "zh": "老板姓名"
 },
