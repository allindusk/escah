 "key138": {
  "ja": "ノロイ総力戦  ",
  "zh": "诺罗伊総力战"
 },
 "key139": {
  "ja": "特別クエスト・ボスステージ\u0001ノロイは膨大なスタミナを持っています。\u0001戦闘を繰り返し、ダメージを蓄積させて撃退しましょう。\u0001※ノロイは撃退すると再度戦闘することはできません。",
  "zh": "特殊任务/首领关卡\u0001诺罗伊拥有惊人的体能。\u0001反复交战，造成大量伤亡，然后撤退。\u0001*Noroi一旦战败就无法再次交战。"
 },
 "key140": {
  "ja": "難易度NORMALの第2部Area18-12をクリアしてメインストーリー第2部「9章7話」を閲覧することで、ノロイ総力戦が解放される。",
  "zh": "通关难度NORMAL的第2部Area18-12并阅览主线剧情第2部「9章7话」后，诺罗伊总力战将解锁。"
 },
 "key141": {
  "ja": "\nメインストーリーを読まずに進んできたプレイヤーは、読まなければ進行することが出来ない。",
  "zh": "未阅读主线剧情就推进的玩家，若不阅读便无法继续推进。"
 },
 "key142": {
  "ja": "\n第1部Area36における",
  "zh": ""
 },
 "key143": {
  "ja": "閂市防衛戦",
  "zh": "闩市防卫战"
 },
 "key144": {
  "ja": "や第1部Area38の",
  "zh": ""
 },
 "key145": {
  "ja": "最終決戦",
  "zh": "最终决战"
 },
 "key146": {
  "ja": "と同様のレイドバトル形式。",
  "zh": ""
 },
 "key147": {
  "ja": "\nノロイ総力戦も過去の同様の戦闘と同じく",
  "zh": ""
 },
 "key148": {
  "ja": "難易度NORMAL限定となっておりHARD、EXTRAでは最終決戦は発生しない。",
  "zh": ""
 },
 "key149": {
  "ja": "\nレイドイベントとの違いは",
  "zh": "与讨伐活动的区别在于"
 },
 "key150": {
  "ja": "1回の挑戦にレイド蛍ではなくスタミナを消費すること\n",
  "zh": "每次挑战消耗体力而非突袭战萤火"
 },
 "key151": {
  "ja": "スタミナ消費半減キャンペーン中でも消費量は変化なし",
  "zh": "即使在体力消耗减半活动期间，消耗量也不变"
 },
 "key152": {
  "ja": "出撃可能人数が３０人",
  "zh": "可出战人数是３０人"
 },
 "key153": {
  "ja": "助っ人の使用が可能",
  "zh": "可以使用助战"
 },
 "key154": {
  "ja": "戦闘回数に応じて有利な効果が付与される\n",
  "zh": "依战斗次数被赋予有利效果"
 },
 "key155": {
  "ja": "戦闘回数",
  "zh": "战斗次数"
 },
 "key156": {
  "ja": "効果",
  "zh": "效果"
 },
 "key157": {
  "ja": "3戦目以降",
  "zh": "3场以后"
 },
 "key158": {
  "ja": "FEVERゲージ増加量UP",
  "zh": "FEVER槽增加量UP"
 },
 "key159": {
  "ja": "5戦目以降",
  "zh": "5场以后"
 },
 "key160": {
  "ja": "戦闘開始時FEVERゲージ最大",
  "zh": "战斗开始时FEVER槽最大"
 },
 "key161": {
  "ja": "7戦目以降",
  "zh": "7场以后"
 },
 "key162": {
  "ja": "更にFEVERゲージ増加量UP",
  "zh": "进一步FEVER槽增加量UP"
 },
 "key163": {
  "ja": "10戦目以降",
  "zh": "第10场以后"
 },
 "key164": {
  "ja": "BREAKランプ最大値-2",
  "zh": "BREAK灯最大值-2"
 },
 "key165": {
  "ja": "詳細は",
  "zh": ""
 },
 "key166": {
  "ja": "レイド",
  "zh": "突袭战"
 },
 "key167": {
  "ja": "へ。",
  "zh": ""
 },
 "key168": {
  "ja": "\nスペシャル助っ人に「",
  "zh": ""
 },
 "key169": {
  "ja": "超昂閃忍ハルカ",
  "zh": "超昂闪忍遥"
 },
 "key170": {
  "ja": "超昂閃忍スバル",
  "zh": "超昂闪忍昴"
 },
 "key171": {
  "ja": "超昂閃忍ナリカ",
  "zh": "超昂闪忍成香"
 },
 "key172": {
  "ja": "」の3体(自身のプレイヤーLVと同じLVの☆3)を借りることができる。",
  "zh": ""
 },
 "key173": {
  "ja": "\nスーパードリルLV.3、衝撃のあるベルトLV.3、縛り亀甲、ハニージッポを装備しているので、戦闘不能になると全快するオマケまでついている。",
  "zh": "因其装备了超级钻头LV.3、冲击腰带LV.3、束缚龟甲、哈尼打火机，还附带战斗不能时完全恢复的赠品。"
 },
 "key174": {
  "ja": "ノロイ総力戦をクリアするとメインストーリー第2部「9章8話」の再生が可能になる。",
  "zh": "通关诺罗伊总力战后，便可重新观看主线剧情第2部「9章8话」。"
 },
