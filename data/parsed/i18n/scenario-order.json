{
 "key1": {
  "ja": "イベント一覧 > ",
  "zh": ""
 },
 "key2": {
  "ja": "メインシナリオ・イベントシナリオ実装時系列まとめ",
  "zh": "主线剧情·活动剧情实装时间线汇总"
 },
 "key3": {
  "ja": "メインシナリオ・イベントシナリオ実装時系列まとめ   ",
  "zh": "主线剧情·活动剧情实装时间线汇总"
 },
 "key4": {
  "ja": "全メインシナリオ・イベントシナリオを実装時系列順にまとめています。\n",
  "zh": "所有主线剧情・活动剧情均按实装时间顺序汇总。"
 },
 "key5": {
  "ja": "この順番に読んでいけば全てのストーリーを時系列で把握できる…はず！",
  "zh": "按照这个顺序看下去的话，应该就能按时间线掌握所有的故事……大概！"
 },
 "key6": {
  "ja": "メインストーリーで突然知らないキャラが登場した際の初出イベント確認用途などにご利用ください。\n",
  "zh": "当主线故事中突然登场未知角色时，可用于确认其初登场活动等，请善加利用。"
 },
 "key7": {
  "ja": "視認性を考慮し2週間イベントの後半実装キャラも、まとめて記載されています（後半キャラは表記の日付より1週間遅れで実装・フェス関連は別表記）",
  "zh": "出于视认性考虑，为期2周的活动中后半实装的角色也一并记录在内（后半角色的实装时间比标注日期晚1周·Fes庆典相关另行标注）"
 },
 "key8": {
  "ja": "広域戦シナリオもフォローしたかったのですが開催毎の区切りが分からなかったので断念。",
  "zh": "本想把广域战剧情也包含进来，但因为分不清每次举办的界限所以作罢了。"
 },
 "key9": {
  "ja": "エイプリルフール企画等は含まれていません（ゲーム内から閲覧は可能）",
  "zh": "不包含愚人节企划等内容（可在游戏内浏览）"
 },
 "key10": {
  "ja": "視認性の問題から一部イベント名を改行表記していますが本来のイベント名称に改行はありません。",
  "zh": "出于视认性问题，部分活动名称进行了换行标注，但原本的活动名称是没有换行的。"
 },
 "key11": {
  "ja": "同名イベントが複数個横に並ぶ箇所は複数勢力に渡って展開する内容です。",
  "zh": "同名活动横向并列多个的地方，代表该内容跨越了多个势力展开。"
 },
 "key12": {
  "ja": "同系列のストーリーはネタバレが無いと思われる範囲内で括弧付で系列名を付記しています。\n",
  "zh": "同一系列的故事，在不剧透范围内以括号附注系列名。"
 },
 "key13": {
  "ja": "一部間違っている場所もあると思いますが追々修正予定です。",
  "zh": "虽然感觉应该有一部分写错的地方，但打算日后陆续修正。"
 },
 "key14": {
  "ja": "白い背景色は恒常化されゲーム内で常時閲覧可能なイベントです。",
  "zh": "白色背景为已常驻化、游戏内可随时浏览的活动。"
 },
 "key15": {
  "ja": "\nピンクの背景色はバトル系のイベントです。関連するシナリオがゲーム内で閲覧可能です。",
  "zh": "粉色背景为战斗类活动。相关剧情可在游戏内浏览。"
 },
