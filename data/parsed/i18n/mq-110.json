 "key160": {
  "ja": "アカシャ・レコロディア",
  "zh": "阿卡夏·雷科洛迪亚"
 },
 "key161": {
  "ja": "資金10,000,蝶鉱石x30,銀の巫女絵馬x2,SSR確定ガチャチケットx1,元気の原液・高純度x3,壁に開限x5",
  "zh": "资金10,000,蝶矿石x30,银巫女绘马x2,SSR确定抽卡券x1,活力原液·高纯度x3,壁限突破素材x5"
 },
 "key162": {
  "ja": "特徴\n",
  "zh": "特征"
 },
 "key163": {
  "ja": "ダメージ量 35.0% 軽減率 60.0% ターゲット人数 3人 攻撃待機時間 11~15sec スタミナ減少量 2%/sec",
  "zh": "伤害量 35.0% 减免率 60.0% 目标人数 3人 攻击待机时间 11~15sec 体力减少量 2%/sec"
 },
 "key164": {
  "ja": "スタミナが100万を切ると2段階目に形態が変化。軽減率 70.0% ターゲット人数 4人に強化される。",
  "zh": "体力低于100万时形态变化为第2阶段，减免率强化至70.0%、目标人数4人。"
 },
 "key165": {
  "ja": "ここまで進んで来たプレイヤーであれば、特に問題なく倒すことが出来るだろう。",
  "zh": "若是推进到这一步的玩家，应该能毫无问题地击败吧。"
 },
