 "key51": {
  "ja": "設定しているだけで",
  "zh": ""
 },
 "key52": {
  "ja": "「優先1」",
  "zh": ""
 },
 "key53": {
  "ja": "に配置したキャラの各種",
  "zh": ""
 },
 "key54": {
