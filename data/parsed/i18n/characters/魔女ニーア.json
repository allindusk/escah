 },
 "key142": {
  "ja": "鳥頭より鳥頭 ",
  "zh": "比笨蛋还笨蛋"
 },
 "key143": {
  "ja": "ちなみにバンシーは別に死を運んだりしないし叫び声を聞いたとて寿命に影響は何も無い。",
  "zh": "顺带报丧女妖并不会带来死亡，听到叫声也对寿命毫无影响。"
 },
 "key144": {
  "ja": "2025-09-03 (水) 20:39:39",
  "zh": "2025-09-03 (周三) 20:39:39"
 },
 "key145": {
  "ja": "死を予告するのが変じて死を運ぶと思う人が居てもおかしかないとは思うが　寿命なんて曖昧な概念だしな",
  "zh": "认为预告死会转变为运送死的人或许也有，但寿命这种概念本就暧昧啊"
 },
 "key146": {
  "ja": "2025-09-03 (水) 20:42:34",
  "zh": "2025-09-03 (周三) 20:42:34"
 },
 "key147": {
  "ja": "告死鳥みたいに死ぬ時しか出てこないならそうなることもあるだろうけど一族付き妖精だから別に死ぬ時以外も普通に出るからね",
  "zh": "若像告死鸟那样只在死时才出现的话或许会那样，但她是随族妖精所以死以外的时候也普通会出现呢"
 },
 "key148": {
  "ja": "2025-09-03 (水) 20:54:50",
  "zh": "2025-09-03 (周三) 20:54:50"
 },
 "key149": {
  "ja": "バンシーの細かい設定設定分かる人にとってはそうかもなー　叫んで泣いたらだれか死ぬ女くらいのイメージの方が強い気はする",
  "zh": "对了解报丧女妖详细设定的人来说或许如此——但感觉\"一叫就哭谁就会死\"的女人这种印象更强"
 },
 "key150": {
  "ja": "2025-09-03 (水) 21:19:06",
  "zh": "2025-09-03 (周三) 21:19:06"
 },
 "key151": {
  "ja": "超昂大戦の幻魔の設定は本来の性質よりも人が持つイメージの方に左右されるから、その辺で能力が変わってるのもありそう",
  "zh": "超昂大战的幻魔设定比起本来性质更受人类持有的印象左右，所以能力在那方面发生变化也有可能"
 },
 "key152": {
  "ja": "2025-09-03 (水) 21:59:19",
  "zh": "2025-09-03 (周三) 21:59:19"
 },
 "key153": {
  "ja": "布が多いのに肌面積多いデザイン良いかも知れない。布を無理矢理切り取った見たいな違和感もかなり少ない。この子好きだ。",
  "zh": "布料很多却肌肤面积也多的设计或许不错。几乎没强行裁布般的违和感。喜欢这孩子。"
 },
 "key154": {
  "ja": "2025-09-04 (木) 10:12:58",
  "zh": "2025-09-04 (周四) 10:12:58"
 },
 "key155": {
  "ja": "開幕確定即死はどこかで何かに刺さる気はする　Rとしては面白い性能",
  "zh": "开幕确定即死感觉会在某处某物上起效　作为R是有趣的性能"
 },
 "key156": {
  "ja": "2025-09-05 (金) 02:41:25",
  "zh": "2025-09-05 (周五) 02:41:25"
 },
 "key157": {
  "ja": "アッシー君の扱いが酷過ぎる……",
  "zh": "对跑腿君的对待太过分了……"
 },
 "key158": {
