 },
 "key91": {
  "ja": "イベント「",
  "zh": ""
 },
 "key92": {
  "ja": "Rance-石をもとめて-",
  "zh": ""
 },
 "key93": {
  "ja": "「RanceⅡ―反逆の姉妹たち―」",
  "zh": ""
 },
 "key94": {
  "ja": "のボスキャラクターとして登場。",
  "zh": ""
 },
 "key95": {
  "ja": "\nアドベンチャーパートにボイスは無いが、イベントのタイトルコールと戦闘時のボイスは存在する。",
  "zh": ""
 },
 "key96": {
  "ja": "イベント終盤では主だったイベントボスと共通で、強化版となる「ランスEX」「ランスSP」が登場する。他に「鬼畜戦士ランス」、「鬼畜戦士ランス★★★★★」、「帰ってきたランス★★★★★」など。",
  "zh": ""
 },
 "key97": {
  "ja": "鬼畜モードでは凄まじい防御力とHPで、レベル50カンストしたキャラクターの猛攻でもビクともせず、通常攻撃の連撃であっさり自軍のキャラを撃沈させるほど。",
  "zh": ""
 },
 "key98": {
  "ja": "\n必殺技(横一列攻撃のランスアタック)が飛んでこようものならレベル50完凸キャラクターでも潰滅状態に追い込まれる。\n",
  "zh": ""
 },
 "key99": {
  "ja": "エスカ・ルビー",
  "zh": ""
 },
 "key100": {
  "ja": "（固有能力発動中）や高火力なSSRならともかく、普通のキャラでは打撃で削り切るのは困難。",
  "zh": ""
 },
 "key101": {
  "ja": "や",
  "zh": ""
 },
 "key102": {
  "ja": "七の賢腕シャムエル",
  "zh": ""
 },
 "key103": {
  "ja": "の割合ダメージで削り切るのが有効。",
  "zh": ""
 },
 "key104": {
  "ja": "実はボスキャラでありながら",
  "zh": ""
 },
 "key105": {
  "ja": "魅了耐性が低い",
  "zh": ""
 },
 "key106": {
  "ja": "という弱点があり、",
  "zh": ""
 },
 "key107": {
  "ja": "エスカ・アメイズ",
  "zh": ""
 },
 "key108": {
  "ja": "や",
  "zh": ""
 },
 "key109": {
  "ja": "神騎リゲル",
  "zh": ""
 },
 "key110": {
  "ja": "で魅了するとあっさり取り巻きのフーマンを攻撃し始める。",
  "zh": ""
 },
 "key111": {
  "ja": "ランスなら納得の行動である",
  "zh": ""
 },
 "key112": {
  "ja": "スタンも無効化はされないので、",
  "zh": ""
 },
 "key113": {
  "ja": "ビートファインダー・フェリニ",
  "zh": ""
 },
 "key114": {
  "ja": "も投入すると一方的にハメ倒すことも出来る。",
  "zh": ""
 },
 "key115": {
  "ja": "2023/10/04にSSRのサポーターとして実装された。",
  "zh": ""
 },
 "key116": {
  "ja": "2026/09/23にコラボイベントでの学生版がSSRサポーターとして実装。",
  "zh": ""
 },
 "key117": {
  "ja": "小ネタ  ",
  "zh": ""
 },
 "key118": {
  "ja": "アリスソフトが設立、デビュー時に発売した作品『Rance -光をもとめて-』から2018年発売の『Rance X -決戦-』まで続いた看板シリーズ「Rance」の主人公。",
  "zh": ""
 },
 "key119": {
  "ja": "\nガハハ笑いに「グッドだ！」「俺のハイパー兵器をくらえ！」などの迷？台詞と共に暴れる豪快かつ傍若無人な振る舞いは今作でも健在。\n",
  "zh": ""
 },
 "key120": {
  "ja": "Ranceシリーズの登場キャラはバラバラの時間軸でやってくるが、ランス本人は本編終了後の時間軸から来ており、",
  "zh": ""
 },
 "key121": {
  "ja": "一番人格が落ち着いた時期",
  "zh": ""
 },
 "key122": {
  "ja": "でもある。",
  "zh": ""
 },
 "key123": {
  "ja": "つまりこれで原作本編からかなり丸くなった状態である。これで。",
  "zh": ""
 },
 "key124": {
  "ja": "コラボイベントのストーリーでは敵対することもあって、本編よりマイルドとはいえ人を選ぶ描写となっているが、キャラストーリーではほぼ主人公として立ち回るので印象がかなり変わる。",
  "zh": ""
 },
 "key125": {
  "ja": "\nイベントストーリーだけ見て嫌いになった、という人は配布の",
  "zh": ""
 },
 "key126": {
  "ja": "ウルザ",
  "zh": ""
 },
 "key127": {
  "ja": "のストーリーだけでも見てみると、多少悪印象が薄れるかもしれない。",
  "zh": ""
 },
 "key128": {
  "ja": "戦闘能力と豪快な性格から来る勢いも規格外だが、それに加えて主人公補正とも言うべき豪運も持つ。",
  "zh": ""
 },
 "key129": {
  "ja": "\n「偶然立ち寄った場所が敵の本拠地だった」「攻撃をしかけたタイミングが丁度相手にとって都合が悪い時だった」などは茶飯事であり、本作でもトキサダにダイビート潰滅の可能性を予感させた程の脅威となって襲い掛かってきた。",
  "zh": ""
 },
 "key130": {
  "ja": "主人公が凌辱行為を行うエロゲ主人公というだけあり、女性を見かけたら容赦なく自分のものにしようとするし男は容赦なく殺す。",
  "zh": ""
 },
 "key131": {
  "ja": "\n自分が凌辱などの酷い行為をする事には一切の躊躇いは無いが、他の男がそれを行う事は許さないなど、身勝手ながらも彼なりに女性を想う気持ちは持っている。\n",
  "zh": ""
 },
 "key132": {
  "ja": "このためRanceシリーズからの登場メンバーは基本的に",
  "zh": ""
 },
 "key133": {
  "ja": "トキサダ",
  "zh": ""
 },
 "key134": {
  "ja": "とはDチャージを行なわず、街中などで鉢合わせたランスがそのままエッチを行う事で結果的にDチャージを行っている事がキャラストーリーにて語られている。ADDDによるチャージは相性や効率の差はあれどエナジー補給は特定の人物に依存しないので、ハイパー兵器が絶好調なランスとの行為ならば問題なくD2エナジーのチャージができる模様。",
  "zh": ""
 },
 "key135": {
  "ja": "過去に『FLOWER KNIGHT GIRL』『女神にキスを！』『千年戦争アイギス』など、他のDMMゲームス作品でもコラボは行われているのだが、そちらでも主人公と出張ヒロインとの本番行為は行っておらずランス本人か知性の乏しいクリーチャーによる凌辱止まりだったりする。",
  "zh": ""
 },
 "key136": {
  "ja": "諸々のイベントを経た末に、ランスの事を家族と勘違いしているお婆さんの家に居候しながら、シィルの捜索とフーマンゲートのよるランス世界の関係者の召喚チャレンジを繰り返している、という状況に落ち着いている。",
  "zh": ""
 },
 "key137": {
  "ja": "イベントシナリオ後日談ネタバレ",
  "zh": ""
 },
 "key138": {
  "ja": "イベント冒頭（石を求めて-第五話）でシィルとはぐれたが、フーマンドアから召喚されるフーマンをまとめあげ、一大勢力としてまとめ上げてしまった。",
  "zh": ""
 },
 "key139": {
  "ja": "\nダイビートではこのランスの勢力を",
  "zh": ""
 },
 "key140": {
  "ja": "カオスマスター",
  "zh": ""
 },
 "key141": {
  "ja": "と呼称する事になる。\n",
  "zh": ""
 },
 "key142": {
  "ja": "ちなみにランスは別にフーマンを召喚するつもりはなく、元の世界の仲間を召喚するつもりなのだが、フーマン以外の召喚は事故なので成功率は限りなく低い…のだが、持ち前の主人公補正による豪運で",
  "zh": ""
 },
 "key143": {
  "ja": "どうにかなってしまったりする",
  "zh": ""
 },
 "key144": {
  "ja": "その後もランスコラボ系シナリオではだいたい出番があったが…。",
  "zh": ""
 },
 "key145": {
  "ja": "さらにネタバレ",
  "zh": ""
 },
 "key146": {
  "ja": "第一部最終決戦真っ只中の18章にて",
  "zh": ""
 },
 "key147": {
  "ja": "ウルザ",
  "zh": ""
 },
 "key148": {
  "ja": "の機転で決戦に参加する事に。",
  "zh": ""
 },
 "key149": {
  "ja": "\nこれまでメインストーリーに絡まなかったランス組がまとめてメインストーリーに登場する事となった。",
  "zh": ""
 },
