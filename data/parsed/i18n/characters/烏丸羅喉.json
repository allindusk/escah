 "key99": {
  "ja": "小ネタ  ",
  "zh": ""
 },
 "key100": {
  "ja": "2024年11月の4周年イベント「",
  "zh": ""
 },
 "key101": {
  "ja": "愛の瞳　守護の槍",
  "zh": ""
 },
 "key102": {
  "ja": "」にて登場した人物。",
  "zh": ""
 },
 "key103": {
  "ja": "\n虚無僧姿で活動しつづけていたが、タイガージョーと交戦して正体を看破されたと思に素顔が明らかになった。",
  "zh": ""
 },
 "key104": {
  "ja": "魔女外伝2など、魔女関係のシナリオの裏で托鉢僧が目撃されている、と言及されており、実はかなり前からダイビートとの縁があった事がわかる。",
  "zh": ""
 },
 "key105": {
  "ja": "元々は「カルス・ウゴール」と名乗っていた男性であり、",
  "zh": ""
 },
 "key106": {
  "ja": "獣頭拳将タイガージョー",
  "zh": ""
 },
 "key107": {
  "ja": "と過去に戦っている。",
  "zh": ""
 },
 "key108": {
  "ja": "\n名前を変えつつ、虚無僧姿で行動するにあたって名前をもじった日本風の名前を名乗るようになっている。",
  "zh": ""
 },
 "key109": {
  "ja": "元ネタは「Only You -世紀末のジュリエット達-」（1996）の登場人物である鴉丸羅喉。こちらは男性である。\n",
  "zh": ""
 },
 "key110": {
  "ja": "「Only you －リ・クルス－」（2001）は「Only You -世紀末のジュリエット達-」のリメイク版。こちらにも登場している。",
  "zh": ""
 },
 "key111": {
  "ja": "タイガージョーとは元ネタの作品を同一とする人物。",
  "zh": ""
 },
 "key112": {
  "ja": "ネタバレ注意",
  "zh": ""
 },
 "key113": {
  "ja": "5周年イベント",
  "zh": ""
 },
 "key114": {
  "ja": "死者の妄執、生者の望み",
  "zh": ""
 },
 "key115": {
  "ja": "にて詳細が判明した。",
  "zh": ""
 },
 "key116": {
  "ja": "\n元々「カルス・ウゴール」という男性であったのは上記の通りであるが、好敵手であった女性「マウラ・ユージン」の身体に魂を宿している。",
  "zh": ""
 },
 "key117": {
  "ja": "\nカルス自身は既に死亡しており、マウラの妹である「メグ・ユージン」の能力によって魂をマウラの身体に留めることになった。",
  "zh": ""
 },
 "key118": {
  "ja": "\n生前に果たされなかったマウラとの決着を望み、死亡したと思われていたマウラとの再会を求めて魂の行きつく先である地獄を現世に顕現させるべく暗躍していた。",
  "zh": ""
 },
 "key119": {
  "ja": "\nしかし実際はマウラは肉体・魂共に死亡しておらず、生きたマウラの身体に自身が宿っていたため彼の目的は決して果たすことができないものであった。",
  "zh": ""
 },
 "key120": {
  "ja": "\n最終的にはメグの力を継承した",
  "zh": ""
 },
 "key121": {
  "ja": "ノノノ",
  "zh": ""
 },
 "key122": {
  "ja": "によってマウラの身体から解き放たれて輪廻の輪に還った。新たな身体に転生することが示唆されているため、今後の展開によっては別の姿で再登場するかもしれない。",
  "zh": ""
 },
 "key123": {
  "ja": "公式ツイッターの紹介  ",
  "zh": ""
 },
 "key124": {
  "ja": "キャラ紹介",
  "zh": ""
 },
 "key125": {
  "ja": "コメントフォーム  ",
  "zh": ""
 },
 "key126": {
  "ja": "クリックで過去ログ一覧を開く",
  "zh": ""
 },
 "key127": {
  "ja": "末尾の番号が若いほど、古いログになります。",
  "zh": ""
 },
 "key128": {
  "ja": "'コメント/烏丸羅喉/' には、下位層のページがありません。",
  "zh": ""
 },
 "key129": {
  "ja": "かつてタイガージョーと戦った漢である人間の男性カルス・マウラ・ウゴールの魂であり、その姿はのののの姉上？（ただしのののの姉の実在は確認できない）。戦国時代末期にガンダーラの秘術を使い九尾狐を封印し、朝廷の要請を受けてその封印を加工した怨念濾過装置を作った術者のようだが、何故か日本に九尾を封印した情報はガンダーラに伝わっていなかった。今回の封印開放は封印に使っていた接現力の塊を回収するのが目的だったようだが、その用途も不明。まとめてみたら謎しか無いな、この人",
  "zh": ""
 },
 "key130": {
  "ja": "2024-11-16 (土) 17:22:54",
  "zh": "2024-11-16 (周六) 17:22:54"
 },
 "key131": {
  "ja": "最終目的は破滅をもたらす者かな？ ",
  "zh": ""
 },
 "key132": {
  "ja": "でも長官君の手に出てきちゃって今度の敵は地球の人たちだーみたいな ",
  "zh": ""
 },
 "key133": {
  "ja": "でもやるとしたら四部あたりかねえ魔女関連で",
  "zh": ""
 },
 "key134": {
  "ja": "2024-11-16 (土) 20:37:08",
  "zh": "2024-11-16 (周六) 20:37:08"
 },
 "key135": {
  "ja": "ビジュアル結構好きなんだよな",
  "zh": ""
 },
 "key136": {
  "ja": "2024-11-16 (土) 20:49:11",
  "zh": "2024-11-16 (周六) 20:49:11"
 },
 "key137": {
  "ja": "記憶が曖昧だけどたしかOnlyYouの烏丸羅喉の妹ってめっちゃ強い能力持ってたけど実験体にされて殺されたとかだったよね。 本当にノノノが妹ならノノノに危害を加えるような事しないような気もするけども……",
  "zh": ""
 },
 "key138": {
  "ja": "2024-11-17 (日) 22:27:00",
  "zh": "2024-11-17 (周日) 22:27:00"
 },
 "key139": {
  "ja": "のののの中に妹の魂が宿ってるタイプじゃないかな、オルタナ四天王みたいに ",
  "zh": ""
 },
 "key140": {
  "ja": "だから人間としてののののに姉は存在しないし、人間としてののののを妹だと認識はできないとか",
  "zh": ""
 },
 "key141": {
  "ja": "2024-11-17 (日) 22:43:50",
  "zh": "2024-11-17 (周日) 22:43:50"
 },
 "key142": {
  "ja": "まさか女体化してくるとは。しかも結構重要なポジション",
  "zh": ""
 },
 "key143": {
  "ja": "2024-11-26 (火) 19:41:06",
  "zh": "2024-11-26 (周二) 19:41:06"
 },
 "key144": {
  "ja": "なんとなく最終的に敗因がなんだったかを考えた時に「タイガージョーと因縁を持ってしまった事が全てですかね…」ってなりそうな気配を感じる",
  "zh": ""
 },
 "key145": {
  "ja": "2024-11-28 (木) 11:00:17",
  "zh": "2024-11-28 (周四) 11:00:17"
 },
 "key146": {
  "ja": "そういえば誰も突っ込んでないけど、虚無僧姿は銀髪繋がりでアトラク＝ナクアの銀が元ネタ？",
  "zh": ""
 },
 "key147": {
  "ja": "2024-11-28 (木) 11:46:44",
  "zh": "2024-11-28 (周四) 11:46:44"
 },
 "key148": {
  "ja": "マスターアジアじゃない？",
  "zh": ""
 },
 "key149": {
  "ja": "2024-11-28 (木) 18:29:46",
  "zh": "2024-11-28 (周四) 18:29:46"
 },
 "key150": {
  "ja": "中の人が成仏したってことで、烏丸羅喉の話はいちおう解決でいいのかな？",
  "zh": ""
 },
 "key151": {
  "ja": "2025-11-19 (水) 02:44:18",
  "zh": "2025-11-19 (周三) 02:44:18"
 },
 "key152": {
  "ja": "大悪司の助っ人枠にもいなかったっけ？",
  "zh": ""
 },
 "key153": {
  "ja": "2025-11-25 (火) 11:22:31",
  "zh": "2025-11-25 (周二) 11:22:31"
 },
 "key154": {
  "ja": "何週かしたあとPMと戦うとき傭兵で雇える ",
  "zh": ""
 },
 "key155": {
  "ja": "そっちでもまあ普通に男",
  "zh": ""
 },
 "key156": {
  "ja": "2025-11-25 (火) 18:10:17",
  "zh": "2025-11-25 (周二) 18:10:17"
 },
 "key157": {
  "ja": "若干若い頃な感じだったっけ",
  "zh": ""
 },
 "key158": {
  "ja": "2025-12-06 (土) 01:41:29",
  "zh": "2025-12-06 (周六) 01:41:29"
 },
 "key159": {
  "ja": "若いっていうか妹普通に生きてるみたいだったから闇落ち前なんだと思う",
  "zh": ""
 },
 "key160": {
  "ja": "2025-12-06 (土) 03:16:34",
  "zh": "2025-12-06 (周六) 03:16:34"
 },
 "key161": {
  "ja": "男っていうか耽美系のホモだったからだいぶ元のゲームとは違う感じ",
  "zh": ""
 },
 "key162": {
  "ja": "2025-12-08 (月) 04:54:26",
  "zh": "2025-12-08 (周一) 04:54:26"
 },
