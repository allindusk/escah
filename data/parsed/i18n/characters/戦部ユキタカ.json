 },
 "key78": {
  "ja": "と同じ世界における上弦衆頭領であり、そちらの",
  "zh": ""
 },
 "key79": {
  "ja": "閃忍ゲッカ",
  "zh": ""
 },
 "key80": {
  "ja": "とは恋仲にある。\n",
  "zh": ""
 },
 "key81": {
  "ja": "イベントではレンゴクに敗退したため一時的に時空転移の儀で避難するはずが、偶発的な事故で次元も超えて",
  "zh": ""
 },
 "key82": {
  "ja": "戦部トキサダ",
  "zh": ""
 },
 "key83": {
  "ja": "と融合してしまった。",
  "zh": ""
 },
 "key84": {
  "ja": "しかし事故による転移と融合が発生した事で",
  "zh": ""
 },
 "key85": {
  "ja": "逆転の",
  "zh": ""
 },
 "key86": {
  "ja": "秘策",
  "zh": ""
 },
 "key87": {
  "ja": "を掴むための情報を伝える役割を担う事となった。",
  "zh": ""
 },
