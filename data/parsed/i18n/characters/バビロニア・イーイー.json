 },
 "key122": {
  "ja": "これまでで今更だけど正月イーイーだよね",
  "zh": "现在才说可能有点晚，但这就是新年伊伊吧。"
 },
 "key123": {
  "ja": "2026-11-19 (木) 03:37:34",
  "zh": "2026-11-19 (周四) 03:37:34"
 },
 "key124": {
  "ja": "和装のセラフィールが明らかに正月用に発注したデザインだったりハロウィンヴィアールにハロウィン要素なかったりたまに流用っぽいキャラいますよね",
  "zh": "和装塞拉菲尔明显是专门为了新年而设计的，万圣节维阿尔却完全没有万圣节元素，偶尔确实会有这种像是直接复用过来的角色呢。"
 },
 "key125": {
