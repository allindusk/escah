 "key32": {
  "ja": "野明角集寺で副住職を務めていたヴィクトリア派の魔女。",
  "zh": "是在野明角集寺担任副住持的维多利亚派魔女。"
 },
 "key33": {
  "ja": "塗り壁の魔力因子を持ち、漆喰を飛ばして敵の動きを止める。",
  "zh": "拥有涂壁魔力因子，能飞洒灰泥止住敌人行动。"
 },
 "key34": {
  "ja": "幼い頃から魔力因子が表出しやすい体質であったため、",
  "zh": "因自幼便是魔力因子易显现的体质，"
 },
 "key35": {
  "ja": "修行を重ね、変身をせずとも力を操れるようになった。",
  "zh": "经反复修行，即便不变身也能操控力量。"
 },
 "key36": {
  "ja": "彼女にはダイビートの魔女の風紀を容赦なく正してほしい。",
