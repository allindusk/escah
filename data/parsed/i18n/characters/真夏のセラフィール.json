 "key33": {
  "ja": "「今年も夏の太陽は容赦がありません。",
  "zh": "「今年的夏日太阳也毫不留情。"
 },
 "key34": {
  "ja": "だから真夏のセラフィールがみなさんを",
  "zh": "所以真夏的瑟拉菲尔会替大家"
 },
 "key35": {
  "ja": "怪人からも太陽からも守ってみせます！」",
  "zh": "从怪人手中、也从太阳手中守护大家！」"
 },
 "key36": {
  "ja": "海での任務のため、水着型の聖鎧に身を包んだセラフィール。",
  "zh": "为了海上任务，身披泳装型圣铠的瑟拉菲尔。"
 },
 "key37": {
  "ja": "大胆な黒い水着は見る者をどきっとさせるが、",
  "zh": "大胆的黑色泳装令观者心头一紧，"
 },
 "key38": {
  "ja": "レースの羽織が上品さを演出している。",
  "zh": "蕾丝外披又营造出典雅气质。"
 },
 "key39": {
  "ja": "奇蹟によって人を癒す力は健在で、海でもその力は発揮される。",
  "zh": "以奇迹治愈他人的力量依旧健在，在海上也能发挥。"
 },
 "key40": {
  "ja": "水着でも、ぎゅっと癒します♪",
  "zh": "即便是泳装，也给你紧紧治愈♪"
 },
