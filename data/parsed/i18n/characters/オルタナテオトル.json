  "zh": ""
 },
 "key91": {
  "ja": "なんと",
  "zh": ""
 },
 "key92": {
  "ja": "撤退",
  "zh": ""
 },
 "key93": {
  "ja": "この・・・力・・・なんという・・・光！",
  "zh": ""
 },
 "key94": {
  "ja": "ゲームにおいて  ",
  "zh": ""
 },
 "key95": {
  "ja": "終焉法理・オルタナテオトル。",
  "zh": ""
 },
 "key96": {
  "ja": "オルテクトル",
  "zh": ""
 },
 "key97": {
  "ja": "オルシワトル",
  "zh": ""
 },
 "key98": {
  "ja": "の両名が融合し真体となった姿であり、オルタナスタインの真の王といえる。",
  "zh": ""
 },
 "key99": {
  "ja": "\nメインストーリー第18章の最終盤で超昂戦士を滅するためにその姿を現した。",
  "zh": ""
 },
 "key100": {
  "ja": "最終決戦のバトル仕様について",
  "zh": ""
 },
 "key101": {
  "ja": "これまでのステージと違い、解放済みのストーリーを全て閲覧しないと最終決戦が解放されない。",
  "zh": ""
 },
 "key102": {
  "ja": "最終決戦が解放されると、エンディングまでメインストーリーのステージ選択画面におけるBGMがOPアレンジの専用BGMに変更される。",
  "zh": ""
 },
 "key103": {
  "ja": "最終決戦はレイド方式のバトルとなっており、複数回バトルを挑むことで有利になる効果が段階的に追加される。",
  "zh": ""
 },
 "key104": {
  "ja": "サポートユニットとして",
  "zh": ""
 },
 "key105": {
  "ja": "エスカルビー・アステライズ",
  "zh": ""
 },
 "key106": {
  "ja": "が選択可能となっている。",
  "zh": ""
 },
 "key107": {
  "ja": "初回戦闘に限り戦闘開始時に特殊演出が入り、レジェンド超昂戦士３人による攻撃が行われる。",
  "zh": ""
 },
 "key108": {
  "ja": "サポーターについて  ",
  "zh": ""
 },
 "key109": {
  "ja": "メインストーリー第3部開始と併せて実装。",
  "zh": ""
 },
 "key110": {
  "ja": "リリアム・マッカバーン",
  "zh": ""
 },
 "key111": {
  "ja": "と同じく、単体では効果が無く別のアクティブサポーターとのコンボをすることで効果を発揮するタイプ。",
  "zh": ""
 },
 "key112": {
  "ja": "同時に実装された",
  "zh": ""
 },
 "key113": {
  "ja": "オルテクトル",
  "zh": ""
 },
 "key114": {
  "ja": "と",
  "zh": ""
 },
 "key115": {
  "ja": "オルシワトル",
  "zh": ""
 },
 "key116": {
  "ja": "のサポーターのリキャスト、レベルを上げれば消費SP減少効果が追加される。",
  "zh": ""
 },
 "key117": {
  "ja": "\nまた、効果対象のサポーターはこちらの効果でリキャストした場合に効果が強化される。",
  "zh": ""
 },
 "key118": {
  "ja": "\n効果対象のサポーターはどちらもリキャスト時間999秒なので、再使用を狙った戦い方をするならテオトルと同時編成が必要となる。",
  "zh": ""
 },
 "key119": {
  "ja": "ただし、消費SPの都合から初期状態ではSPが足りなくてサポートサプリが必須。サポートLvが低い内でサプリに頼らない場合、テオトルを先に使って効果のブーストのみを狙う事になる。",
  "zh": ""
 },
 "key120": {
  "ja": "\nそれだけでは物足りない部分があるので、本格的に使うならLvをしっかり上げてSP100点で効果対象のサポーター2回＋テオトル1回を成立できるようにしよう。",
  "zh": ""
 },
 "key121": {
  "ja": "サポーター3枠を使いテクトルとテオトル両方を使用してからこちらで再起動、というコンボのできると言えばできるが、最大LvにしてもサポートサプリでのSP回復を行う必要がある。基本的にはどちらか片方との併用だろう。",
  "zh": ""
 },
 "key122": {
  "ja": "コンボ前提サポーターの先達であるリリアムと比較すると、あちらは最初に使って再起動時間短縮で2発目を狙うのに対して、こちらはサポートLvが挙がってSP消費量が減ると、効果対象を先に使った上で即座に再起動を可能にする、という使用感の違いがある。",
  "zh": ""
 },
 "key123": {
  "ja": "小ネタ  ",
  "zh": ""
 },
 "key124": {
  "ja": "声を発する時は必ずオルテクトル、オルシワトル両名の声が重なっているわけではなく、それぞれの声で別人格かのように喋ったりもする。",
  "zh": ""
 },
 "key125": {
  "ja": "オルテクトル",
  "zh": ""
 },
 "key126": {
  "ja": "は",
  "zh": ""
 },
 "key127": {
  "ja": "戦部トキサダ",
  "zh": ""
 },
 "key128": {
  "ja": "に幻魔の力の源である接現力が「人の認識の曖昧さ」から生まれるものである事を看破され、その上で共存の道を提案されていた。",
  "zh": ""
 },
 "key129": {
  "ja": "\nしかしマッキンリーと超昂戦士の戦いから「超昂は滅ぼす」という結論に至りその実行のためにこの姿へ変身すると、閂市とその周辺一帯の人間を石化させるフィールドを展開。",
  "zh": ""
 },
 "key130": {
  "ja": "\n石化した人々に夢を見せ精神を操作することで接現力を無尽蔵に吸収していった。\n",
  "zh": ""
 },
 "key131": {
  "ja": "あまりにも強大な力を発揮する超昂の力を、オルテクトルは「影すら許さぬ太陽」と表現した。",
  "zh": ""
 },
 "key132": {
  "ja": "\nつまり「100%と0%の間の、いるかどうか不確定な部分があるからこそ生きていける幻魔にとって、超昂の力は曖昧な部分を暴き立ててしまう危険すぎるもの」と判断した結果、超昂との共存は不可能と判断してしまった。",
  "zh": ""
 },
 "key133": {
  "ja": "判官は些事",
  "zh": ""
 },
 "key134": {
  "ja": "」の一言で",
  "zh": ""
 },
 "key135": {
  "ja": "部下",
  "zh": ""
 },
 "key136": {
  "ja": "の行いを済ませるのは流石というべきか。\n",
  "zh": ""
 },
 "key137": {
  "ja": "実際、「超昂が魔女にとって危険か？」気にしていたところに超昂の力の応用で",
  "zh": ""
 },
 "key138": {
  "ja": "問答無用で幻魔を即死させる方法",
  "zh": ""
 },
 "key139": {
  "ja": "を確認した為、マッキンリーの造反よりも優先すべき事案と見做されたのは致し方ないだろう。",
  "zh": ""
 },
 "key140": {
  "ja": "公式ツイッターの紹介  ",
  "zh": ""
 },
