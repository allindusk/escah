 "key49": {
  "ja": "2部11章で初登場した国防軍の技術顧問。",
  "zh": ""
 },
 "key50": {
  "ja": "皆代奈月",
  "zh": ""
 },
 "key51": {
  "ja": "山城鷹路",
  "zh": ""
 },
 "key52": {
  "ja": "と共にダイビートの視察を行う。",
  "zh": ""
 },
 "key53": {
  "ja": "高円寺滝太郎",
  "zh": ""
 },
 "key54": {
  "ja": "と同分野の研究を行っているらしく、",
  "zh": ""
 },
 "key55": {
  "ja": "さやか",
  "zh": ""
 },
 "key56": {
  "ja": "もその名前を知っていた。",
  "zh": ""
 },
 "key57": {
  "ja": "2部12章にて",
  "zh": ""
 },
 "key58": {
  "ja": "アカリ",
  "zh": ""
 },
 "key59": {
  "ja": "をスカウトしようとしたが、あえなく断られている。",
  "zh": ""
 },
 "key60": {
  "ja": "小ネタ  ",
  "zh": ""
 },
 "key61": {
  "ja": "外見と名字は「大帝国」に登場したドクツ第三帝国の、「ノンツィヒ・ヒムラー」。",
  "zh": ""
 },
 "key62": {
  "ja": "一方で「ランスⅥ」のアベルト（鎧）、大悪司のタマネギ（手に持った玉葱）の要素も持っている。",
  "zh": ""
 },
 "key63": {
  "ja": "元ネタが元ネタだけに今後の動向が非常に怪しい人物。アカリに接近した際に不安になったプレイヤーも多いと思われる。",
  "zh": ""
 },
 "key64": {
  "ja": "第2部第17章ネタバレ注意",
  "zh": ""
 },
 "key65": {
  "ja": "その身に三つの異世界の魂を宿していると明かされる。明言はされなかったがおそらくは上述の3人。",
  "zh": ""
 },
 "key66": {
  "ja": "\n本来の氷村教授は普通の人間であったが、第1部のエスカ・ルビーの活躍を目にし、彼女を苦しんでいる様を見たいという願望に気付く。",
  "zh": ""
 },
 "key67": {
  "ja": "\n自分の狂った残酷性に愕然とし、自殺を考る程に良識と善性を持ち合わせていた氷村教授は、異世界の魂の召喚という技術を聞き、強い精神を宿せば歪んだ性を正せるのではないかと考えたのだが……",
  "zh": ""
 },
 "key68": {
  "ja": "\n結果は似た性癖のクソ外道2人と一般通過調教師1人が宿ったのであった。元の魂は召喚された三つの魂の中に溶け込んでいるらしい。",
  "zh": ""
 },
 "key69": {
  "ja": "ドーラ教という、宇宙イモムシ（ラムダス）を崇める邪教徒であったヒムラーの魂は、この世界の人間も捧げるべくラムダスの召喚を画策していた。\n",
  "zh": ""
 },
 "key70": {
  "ja": "宇宙イモムシ関連の重要アイテムである赤い石を持つ",
  "zh": ""
 },
 "key71": {
  "ja": "神騎セリカエル",
  "zh": ""
 },
 "key72": {
  "ja": "や、ドーラ教徒疑惑のある",
  "zh": ""
 },
 "key73": {
  "ja": "神騎エルカエル",
  "zh": ""
 },
 "key74": {
  "ja": "とはあまり絡まずに退場となってしまった。",
  "zh": ""
 },
 "key75": {
  "ja": "好みの女性が艱難辛苦を乗り越える様を見たいアベルトの魂は、エスカ・ルビーにご執心だったりそのクローンを作ったりしていた。\n",
  "zh": ""
 },
 "key76": {
  "ja": "元の世界でも",
  "zh": ""
 },
 "key77": {
  "ja": "ランス",
  "zh": ""
 },
 "key78": {
  "ja": "に計画を潰されている。面識のあるような発言はそのため。ランスはアベルトを嫌っていたが、アベルトはランスを気に入っていた。",
  "zh": ""
 },
 "key79": {
  "ja": "調教師であるタマネギの魂は、アルファに絶妙な調教を施し、結果的にノロイと接続させることに成功した。\n",
  "zh": ""
 },
 "key80": {
  "ja": "他の2人に比べると比較的無害な魂なのだが、他の2人の企みは全部失敗に終わったため、結果だけ見れば3人の中で最も爪痕を残した。",
  "zh": ""
 },
 "key81": {
  "ja": "なお、前述の二人に比べ繋がりが薄い様で、定期的に玉葱を丸かじりする事を余儀なくされるようだ。（ちなみに氷村本人は好きでもない。）",
  "zh": ""
 },
