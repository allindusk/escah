 "key70": {
  "ja": "最大Lvで閃忍(久世)の出撃完了時に必殺ゲージ増加100%。",
  "zh": ""
 },
 "key71": {
  "ja": "\n最も恩恵を受けるのは必殺技で宝箱を獲得できる",
  "zh": ""
 },
 "key72": {
  "ja": "閃忍ツカサ",
  "zh": ""
 },
 "key73": {
