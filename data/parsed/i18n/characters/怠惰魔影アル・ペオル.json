 "key25": {
  "ja": "初代魔宰相にして、千年ウォーグリムを統治した",
  "zh": ""
 },
 "key26": {
  "ja": "悪魔の大英雄。",
  "zh": ""
 },
 "key27": {
  "ja": "現在は怠惰魔影として召喚され、",
  "zh": ""
 },
 "key28": {
  "ja": "堕天使たちの指示に従っているが、",
  "zh": ""
 },
 "key29": {
  "ja": "その忠誠は世界の滅びにのみ向けられている。",
  "zh": ""
 },
 "key30": {
  "ja": "ゲームにおいて  ",
  "zh": ""
 },
 "key31": {
  "ja": "小ネタ  ",
  "zh": ""
 },
 "key32": {
  "ja": "第3部第9章にて登場した魔影。それまでに登場した魔影と異なり、生前の記憶と知識を完全に有している。",
  "zh": ""
 },
 "key33": {
  "ja": "\n悪魔史に謳われる大英雄であり比類なき魔術使い。その魔術の腕は",
  "zh": ""
 },
 "key34": {
  "ja": "レガリアの神騎マヤエル",
  "zh": ""
 },
 "key35": {
  "ja": "や",
  "zh": ""
 },
 "key36": {
  "ja": "魔蔑将レイス",
  "zh": ""
 },
 "key37": {
  "ja": "を歯牙にもかけないほど。",
  "zh": ""
 },
 "key38": {
  "ja": "\n更にあくまで魔影であるため、撃破したり自爆したとしても再召喚が可能という無法さを持ちダイビートを苦しめる。",
  "zh": ""
 },
 "key39": {
  "ja": "359年前にロンドンにて黒死病を蔓延させ甚大な災害を招いたが、最終的に当時",
  "zh": ""
 },
 "key40": {
  "ja": "神騎ルクセール",
  "zh": ""
 },
 "key41": {
  "ja": "の補佐だった",
  "zh": ""
 },
 "key42": {
  "ja": "二の聖剣ミカフィール",
  "zh": ""
 },
 "key43": {
  "ja": "によって討ち滅ぼされる",
  "zh": ""
 },
 "key44": {
  "ja": "在りし日には",
  "zh": ""
 },
 "key45": {
  "ja": "魔王ダイモン",
  "zh": ""
 },
 "key46": {
  "ja": "と",
  "zh": ""
 },
 "key47": {
  "ja": "神騎ルクセール",
  "zh": ""
 },
 "key48": {
  "ja": "に仕え、「千年魔宰相」と呼ばれた大悪魔。",
  "zh": ""
 },
 "key49": {
  "ja": "\n彼らとの関係は良好であったはずだったが、現在はダイモンのことを裏切者呼ばわりするなど複雑な過去があるようだが…？\n\n",
  "zh": ""
 },
 "key50": {
  "ja": "その真意",
  "zh": ""
 },
 "key51": {
  "ja": "\n彼の理想とは一言で言えば「悪魔は人とは独立して存在する高潔な種族たるべし」といったものである。",
  "zh": ""
 },
 "key52": {
  "ja": "\n表向きはダイモンの融和政策を支持していたが、実のところはそれにより悪魔が人と同質化することに憤慨しており、それ故に「ダイモンは自分の理想を裏切った」と考えていた。",
  "zh": ""
 },
 "key53": {
  "ja": "\nその独り善がりな理想故に「ダイモンによって悪魔は犠牲にされた」と勝手に考えており、現在の人との融和を望む多くの悪魔たちについては「自分の望む悪魔像と異なるから滅びてしまえばいい」とまで考えている狂人ならぬ狂魔影である。",
  "zh": ""
 },
 "key54": {
  "ja": "\n人も悪魔も一切合切滅ぼし、ダイモンも自身の計略によって苦しみながら死ぬことを望み、人や悪魔と機械兵器の融合した禁断の兵器「レギオン」を生み出してダイビートや世界に牙を剥いたが、",
  "zh": ""
 },
 "key55": {
  "ja": "レガリアの超昂神騎ミカフィール",
  "zh": ""
 },
 "key56": {
  "ja": "によって計略は打ち破られた。",
  "zh": ""
 },
 "key57": {
  "ja": "\nなおレイスの分析によればレギオンをより効率的に運用すれば人類の破滅は容易かったのだが、あくまでも人類廃絶は現在の主人たる",
  "zh": ""
 },
 "key58": {
  "ja": "エクシール・リバース",
  "zh": ""
 },
 "key59": {
  "ja": "が行うべきと考えており、自分はダイモンへの復讐が達成できさえすれば良いと考えていた模様。",
  "zh": ""
 },
 "key60": {
  "ja": "\nレイス曰く「奉仕種族として生まれて、それ以外の生き方を知らない」「誰かに託さないと気が済まない。そして裏切られて怒る」",
  "zh": ""
 },
 "key61": {
  "ja": "\n「怠惰」の名を冠することになったのはこのような生き方故のようだ。\n",
  "zh": ""
 },
 "key62": {
  "ja": "公式ツイッターの紹介  ",
  "zh": "官方推特介绍"
 },
