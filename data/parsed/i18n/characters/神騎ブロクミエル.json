 "key81": {
  "ja": "今でこそ平均値だが、魔法力・行動速度・必殺充填が当時としては非常に優秀だった魔法アタッカー。",
  "zh": "如今虽是平均值，但当时魔法力·行动速度·必杀填充非常优秀的魔法输出。"
 },
 "key82": {
  "ja": "\n防御は低いものの魔防は高く、スタミナも平均程度はある。",
  "zh": "防御虽低但魔防高，体力也至少有平均程度。"
 },
 "key83": {
  "ja": "必殺は全体攻撃+回避デバフ。攻撃支援付の全体攻撃ということで",
  "zh": ""
 },
 "key84": {
  "ja": "魔術師のルカ",
  "zh": "魔术师琉香"
 },
 "key85": {
  "ja": "のものと似た性能。",
  "zh": ""
 },
 "key86": {
  "ja": "\nフィールド対象なので雑魚を殲滅しがてら攻撃を当てやすくしてくれる。\n",
  "zh": "因是领域对象，能在歼灭杂兵之余让攻击更易命中。"
 },
 "key87": {
  "ja": "神騎の回避デバフ持ちは数少ないため貴重と言えば貴重。レイドでは別枠の防御デバフとして作用するのでありがたい。",
  "zh": "神骑的回避减益持有者稀少，故说珍贵便珍贵。在RAID中作为另栏的防御减益作用，令人感激。"
 },
 "key88": {
  "ja": "固有効果の持続ダメージはボス戦ではありがたく、これにより限凸なしでも多少仕事はできるようになっている。同一効果は重複しない。",
  "zh": "固有技能的持续伤害在boss战令人感激，由此即便无限突也能多少干活。同一效果不重叠。"
 },
 "key89": {
  "ja": "弱点は移動速度と出撃速度。出撃まで9+12の計21secであり、",
  "zh": ""
 },
 "key90": {
  "ja": "黒の幻身ミニテクトル",
  "zh": "黑幻身迷你泰克托鲁"
 },
 "key91": {
  "ja": "を除けば最下位グループ。",
  "zh": ""
 },
