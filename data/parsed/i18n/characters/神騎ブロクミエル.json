 "key101": {
  "ja": "フィールド回避ダウン必殺技を持つ唯一の神騎だったりする",
  "zh": "是拥有领域回避下降必杀技的唯一神骑"
 },
 "key102": {
  "ja": "殲滅戦",
  "zh": "歼灭战"
 },
 "key103": {
  "ja": "全体必殺は殲滅戦向きだが効果があまり強くない　(装備例は下記参照)",
  "zh": "全体必杀适合歼灭战但效果不太强　(装备例参见下)"
 },
 "key104": {
  "ja": "Bユニバース",
  "zh": "B宇宙"
 },
 "key105": {
  "ja": "継続ダメージ目当てで起用されることもある",
  "zh": "也有瞄着持续伤害被起用的情况"
 },
 "key106": {
  "ja": "適性の評価指標",
  "zh": "适性评价指标"
 },
 "key107": {
  "ja": "◎：大得意コンテンツ。抜群に活躍する最高の適性がある。",
  "zh": "◎：非常擅长的内容。拥有能大放异彩的最佳适性。"
 },
 "key108": {
  "ja": "\n○：向いているコンテンツ。十分に活躍できる高い適性がある。",
  "zh": "○：适合的内容。拥有足够发挥的高适性。"
 },
 "key109": {
  "ja": "\n△：可もなく不可もない程度。普通。工夫次第でそれなりに活躍させられるが、わざわざ選ぶ必要性は薄い。",
  "zh": "△：不好不坏的程度。普通。花心思也能有相应发挥，但没有特意选它的必要。"
 },
 "key110": {
  "ja": "\n×：向いてないコンテンツ。コンテンツのルールやゲームシステムとの相性、難度等の関係で活躍させることが難しい。",
  "zh": "×：不适合的内容。因与内容规则、游戏系统相性及难度等关系，难以发挥作用。"
 },
