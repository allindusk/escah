 "key33": {
  "ja": "「我、レガリアの超昂神騎～メガエルッ！",
  "zh": "「我，王权超昂神骑～梅加艾尔！"
 },
 "key34": {
  "ja": "……パパ、どうかなっ？",
  "zh": "……爸爸，怎么样？"
 },
 "key35": {
  "ja": "メガエル、ちょっとは立派になった？」",
  "zh": "梅加艾尔，有没有稍微变得可靠些？」"
 },
 "key36": {
  "ja": "新しい姿を形作り、レガリアの超昂神騎となったメガエル。",
  "zh": "塑造出新姿态、成为王权超昂神骑的梅加艾尔。"
 },
 "key37": {
  "ja": "だいすきなみんなといる為――その答えに呼応したレガリアは",
  "zh": "为了待在最喜欢的大家身边——呼应此答案的雷加利亚"
 },
 "key38": {
  "ja": "進化した新たな力をメガエルに授ける。",
  "zh": "将进化后的新力量授予梅加艾尔。"
 },
 "key39": {
  "ja": "奇蹟により戦場全域に自らの分身を『創造』し、",
  "zh": "借由奇迹在战场全域「创造」出自己的分身，"
 },
 "key40": {
  "ja": "仲間たちの傷や疲れを肩代わりさせることが可能。",
  "zh": "并能替伙伴们分担伤痛与疲惫。"
