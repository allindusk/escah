  },
  "key121": {
    "ja": "末尾の番号が若いほど、古いログになります。",
    "zh": "末尾编号越小，日志越旧。"
  },
  "key122": {
    "ja": "'コメント/剣菱圭/' には、下位層のページがありません。",
    "zh": "「评论/剣菱圭/」没有下级页面。"
