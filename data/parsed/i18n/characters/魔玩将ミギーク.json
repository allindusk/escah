 "key24": {
  "ja": "悪魔軍団ウォーグリム、脱魔王派として",
  "zh": ""
 },
 "key25": {
  "ja": "ダイビートに敵対していた魔将。",
  "zh": ""
 },
 "key26": {
  "ja": "狙ったものは絶対に手に入れるという強欲を司る魔玩将に",
  "zh": ""
 },
 "key27": {
  "ja": "恥じぬ強欲ぶりだが、自身にとって価値を見出せれば",
  "zh": ""
 },
 "key28": {
  "ja": "積極的に人間の生み出したものを取り入れる姿勢を持っている。",
  "zh": ""
 },
 "key29": {
  "ja": "ゲームにおいて  ",
  "zh": ""
 },
 "key30": {
  "ja": "メインストーリー3部1章から登場。",
  "zh": ""
 },
 "key31": {
  "ja": "小ネタ  ",
  "zh": ""
 },
 "key32": {
  "ja": "悪魔軍団ウォーグリムの魔将。",
  "zh": ""
 },
 "key33": {
  "ja": "魔蔑将レイス",
  "zh": ""
 },
 "key34": {
  "ja": "にベタ惚れしており、今回の脱魔王派のクーデターにあたっての実行部隊としてマヤやトキサダへの襲撃を行った。",
  "zh": ""
 },
 "key35": {
  "ja": "脳筋なアホの子と思いきや、慌てふためいてると見せかけて罠に陥れるなど地頭はいい描写が見られる。\n",
  "zh": ""
 },
 "key36": {
  "ja": "追い詰められたと思いきや相手をトラップに誘導したり、初対面だった",
  "zh": ""
 },
 "key37": {
  "ja": "メガ美",
  "zh": ""
 },
 "key38": {
  "ja": "の能力とその目的を一目で見抜く、といった戦術・戦略眼にも優れる。",
  "zh": ""
 },
 "key39": {
  "ja": "現代技術にも興味深いらしく、マヤがダイビートのゲーム実況動画向けのゲーミングPCを見た時は「ミギークが食いつきそう」とコメントするなどそっち方面にも理解がある事が言及されている。",
  "zh": ""
 },
 "key40": {
  "ja": "後に案の定、レイスの能力で洗脳状態だったことが判明。ダイビートと交戦して捕縛、その後洗脳を利用して自殺（という名の時間稼ぎ）に使われる等紆余曲折を経た上でダイビートの管理下に入る。",
  "zh": ""
 },
 "key41": {
  "ja": "本来の性格は姉御肌かつ頭の回転や洞察力にも優れる人物。さらに「他者が隠そうとする『宝』の在りかを把握できる」という能力を持つ。このため重要な物品を隠そうとすると逆にミギークに捕捉されるし、設置型のトラップの類もミギークならば一発で見抜く。",
  "zh": ""
 },
 "key42": {
  "ja": "またレイスについては彼が反乱を起こす前から「己の価値を証明しようとする」というハングリー精神は好意を持っていた。そもそも付き合い方も口調こそ荒っぽい上に外見などは好みではないとしつつも、危なっかしいレイスに付き合う姉御的なものであり「問題はあるが見どころもある友人」として洗脳という手を使わなくても友好的だったことが判明する。",
  "zh": ""
 },
 "key43": {
  "ja": "ウェイトは109kg（本人曰く鉄腕込みでの体重）",
  "zh": ""
 },
 "key44": {
  "ja": "元ネタは『超昂神騎エクシール』に登場する魔将ワーズリー。機械の腕や青い肌等の特徴が共通しており、本作では性別が変わった同一存在という立ち位置になっている。",
  "zh": ""
 },
 "key45": {
  "ja": "公式ツイッターの紹介  ",
  "zh": "官方推特介绍"
 },
