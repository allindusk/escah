 "key28": {
  "ja": "想破上弦衆の頭領。",
  "zh": ""
 },
 "key29": {
  "ja": "真面目で厳格な性格で一癖も二癖もある閃忍たちをまとめ上げてきた。",
  "zh": ""
 },
 "key30": {
  "ja": "ボイス  ",
  "zh": ""
 },
 "key31": {
