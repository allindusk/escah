 },
 "key187": {
  "ja": "2025-12-24 (水) 20:22:23",
  "zh": "2025-12-24 (周三) 20:22:23"
 },
 "key188": {
  "ja": "分かる、聖夜っぽさ皆無だし大人しく季節と関係ないイベントで出せばよかったのでは？と思ってしまう",
  "zh": "懂的，完全没圣夜感，不禁觉得不如在和季节无关的活动里出就好了？"
 },
 "key189": {
  "ja": "2025-12-24 (水) 21:21:20",
  "zh": "2025-12-24 (周三) 21:21:20"
 },
 "key190": {
  "ja": "同じようなサンタコスばかりになるのを嫌ったのかもしれないけどずらし過ぎてもクリスマス感薄いものになるよね",
  "zh": "或许是为避免圣诞装都变得千篇一律，但偏移过头也会让圣诞感变淡呢"
 },
 "key191": {
  "ja": "2025-12-25 (木) 04:33:31",
  "zh": "2025-12-25 (周四) 04:33:31"
 },
 "key192": {
  "ja": "チャイナというのは露出は控えめでうなじと二の腕と足のスリットで魅せるものなんだよ！（過激派）",
  "zh": "所谓旗袍，是露出克制、用后颈与二头肌和腿的开衩来展现魅力的东西啊！（过激派）"
 },
 "key193": {
  "ja": "2025-12-25 (木) 08:15:11",
  "zh": "2025-12-25 (周四) 08:15:11"
 },
 "key194": {
  "ja": "清々しいまでの痴女",
  "zh": "爽快到极点的痴女"
 },
 "key195": {
  "ja": "2025-12-24 (水) 21:08:47",
  "zh": "2025-12-24 (周三) 21:08:47"
 },
 "key196": {
  "ja": "どことなく爆裂ハンターっぽさを感じる",
  "zh": "总觉得有点爆裂猎人感"
 },
 "key197": {
  "ja": "2025-12-24 (水) 23:21:43",
  "zh": "2025-12-24 (周三) 23:21:43"
 },
 "key198": {
  "ja": "いくら神騎が人間じゃないからと言って果たして冬にこんな痴女みたいな格好させて罰当たりじゃないんですか？アマツ様",
  "zh": "就算神骑不是人类，这副冬天却穿得像痴女一样的打扮难道不是遭天谴吗？天津神大人"
 },
 "key199": {
  "ja": "2025-12-25 (木) 00:06:26",
  "zh": "2025-12-25 (周四) 00:06:26"
 },
 "key200": {
  "ja": "チャイナ服超えて金太郎腹かけに踏み入れてるんだよな面積的に",
  "zh": "已经超越旗袍踏入了金太郎肚兜领域了呢，从面积上来说"
 },
 "key201": {
  "ja": "2025-12-25 (木) 21:05:12",
  "zh": "2025-12-25 (周四) 21:05:12"
 },
 "key202": {
  "ja": "ふんどし引っ張り上げて胸を隠しましたと言われても納得する",
  "zh": "就算说她把兜裆布拉上来遮住了胸我也会信"
 },
