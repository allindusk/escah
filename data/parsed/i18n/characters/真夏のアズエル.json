 "key146": {
  "ja": "問題なく活躍できるが、わざわざ選ぶ必要性は薄い",
  "zh": "能正常发挥作用，但没有特意选它的必要"
 },
 "key147": {
  "ja": "レイドバトル",
  "zh": "突袭战"
 },
 "key148": {
  "ja": "手動限定の活躍だが、任意撤退を活用しBREAKに時間停止を合わせ続けられれば強い",
  "zh": "虽是仅限手动的活跃，但若活用任意撤退并持续让时间停止配合BREAK就很强"
 },
 "key149": {
