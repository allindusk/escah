 "key37": {
  "ja": "セクシーな黒水着の聖鎧に身を包んだアズエル。",
  "zh": "身披性感黑色泳衣圣铠的阿兹艾尔。"
 },
 "key38": {
  "ja": "神武である神鍵ジェネシスは小型化し胸元に収まっている。",
  "zh": "神武神键创世纪小型化收在胸前。"
