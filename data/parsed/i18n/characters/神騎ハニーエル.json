 },
 "key155": {
  "ja": "一の神鍵アズエル",
  "zh": "一神键阿兹艾尔"
 },
 "key156": {
  "ja": "ビートチューリップ・マリア",
  "zh": "节拍郁金香·玛利亚"
 },
 "key157": {
  "ja": "神騎ベガ",
  "zh": "神骑织女星"
 },
 "key158": {
  "ja": "神騎グラシエル",
  "zh": "神骑格拉西艾尔"
 },
 "key159": {
  "ja": "バレンタインアズエル",
  "zh": "情人节阿兹艾尔"
 },
 "key160": {
  "ja": "理系のアルデバラン",
  "zh": "理科女毕宿五"
 },
 "key161": {
  "ja": "ビートリバイバル・カナリア",
  "zh": "节拍重生·金丝雀"
 },
 "key162": {
  "ja": "ビートハンター・エイム",
  "zh": "节拍猎人·艾姆"
 },
 "key163": {
  "ja": "真夏のアズエル",
  "zh": "盛夏阿兹艾尔"
 },
 "key164": {
  "ja": "サロン・コバリ",
  "zh": "沙龙·小针"
 },
 "key165": {
  "ja": "魔女シャオ",
  "zh": "魔女晓"
 },
 "key166": {
  "ja": "小ネタ  ",
  "zh": "小技巧"
 },
 "key167": {
  "ja": "ハニワ教は闘神都市Ⅱなど過去のアリスソフトのゲームにも出てくる由緒正しい（？）宗教だが、",
  "zh": ""
 },
 "key168": {
  "ja": "大抵怪しい",
  "zh": ""
 },
 "key169": {
  "ja": "なお当人はあくまでも金稼ぎの手段と割り切っており、ハニワ教を信奉しているわけではなく、ハニーも容赦なく壊しまくる。",
  "zh": "另外本人终归是把赚钱手段切割清楚，并非信奉哈尼瓦教，哈尼也毫不留情地砸个不停。"
 },
 "key170": {
  "ja": "詳しくはイベント劇中にて語られているが育児放棄とネグレクトに晒されている家庭であり、そもそもそこまでがめつくなければ生きていけない、というハードな環境で育っている。",
  "zh": "详细在活动剧中叙述但，是暴露于育儿放弃与neglect（忽视）的家庭，本就若非那么贪欲则活不下去，在如此hard的环境成长。"
 },
 "key171": {
  "ja": "ダイビート加入後もハニワ教の神官のバイトを続けているのは「待遇が良くて割もいい職場だから」。",
  "zh": "大beat加入后也继续哈尼瓦教的神官打工，是因为「待遇好且分成也不错的职场」。"
 },
 "key172": {
