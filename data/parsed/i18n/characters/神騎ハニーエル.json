 "key123": {
  "ja": "天空の花嫁神騎",
  "zh": "天空的花嫁神骑"
 },
 "key124": {
  "ja": "の配布Rとして実装されたキャラクター。",
  "zh": ""
 },
 "key125": {
  "ja": "\n無条件の魔法無効効果を持つのが特徴。魔法無効キャラは期間限定SSRの",
  "zh": ""
 },
 "key126": {
  "ja": "ビートビジョン・リズナ",
  "zh": "节拍幻视·莉兹娜"
 },
 "key127": {
  "ja": "以来の2人目。",
  "zh": ""
 },
 "key128": {
  "ja": "物理キャラだが必殺技が魔法攻撃で、攻撃力は低いが魔法力は高い、",
  "zh": ""
 },
 "key129": {
  "ja": "ビートアイドル・アキエ",
  "zh": "节拍偶像·明惠"
 },
 "key130": {
  "ja": "と同タイプ。必殺を重視する場合は行動速度6と遅いのがネック。",
  "zh": ""
 },
 "key131": {
  "ja": "魔法無効なので",
  "zh": ""
 },
 "key132": {
  "ja": "Bユニバース",
  "zh": "B宇宙"
 },
 "key133": {
  "ja": "の",
  "zh": "的"
 },
 "key134": {
  "ja": "カゲリ",
  "zh": "影理"
 },
 "key135": {
  "ja": "オルバ",
  "zh": "奥尔巴"
 },
 "key136": {
  "ja": "の攻撃を受けない。",
  "zh": ""
 },
 "key137": {
  "ja": "\n長髪まねき猫を装備させデコイとして起用するといいだろう。",
  "zh": "最好给它配备一只长毛的、能招财的猫，并把它用作诱饵。"
 },
 "key138": {
  "ja": "\nオルバ戦では",
  "zh": ""
 },
 "key139": {
  "ja": "エンジんスパッツ",
  "zh": "引擎紧身裤"
 },
 "key140": {
  "ja": "装備でLV130リズナよりスタミナが多くなる。近距離キャラなので自傷狙いの出撃スタック戦術に向く。",
  "zh": ""
 },
 "key141": {
  "ja": "必殺は全体攻撃。覚醒で",
  "zh": ""
 },
 "key142": {
  "ja": "サポーター",
  "zh": "支援型（Supporter）"
 },
 "key143": {
  "ja": "を含めた編成・出撃状況によってダメージ倍率が変動する効果が追加される。サポーターを参照する効果は非常に珍しい。",
  "zh": ""
 },
 "key144": {
  "ja": "\nサポーターのハニー+『眼鏡』キャラクターは金策効果があるので、ここにハニーエルを組み込む、という形になるか。",
  "zh": ""
 },
 "key145": {
  "ja": "\nハニーエル自体は眼鏡キャラではないので注意。\n",
  "zh": ""
 },
 "key146": {
  "ja": "必殺を最大限生かすなら自身が",
  "zh": ""
 },
 "key147": {
  "ja": "聖剣コスモス",
  "zh": "圣剑科斯莫斯"
 },
 "key148": {
  "ja": "を装備して他に眼鏡キャラを4体、サポーターにハニー系3体で合計150%+75％のブースト効果となる。",
  "zh": ""
 },
 "key149": {
  "ja": "\n元が4倍の全体必殺のためネタの域は越えないが、威力アップの上昇率はかなり高い。",
  "zh": ""
 },
