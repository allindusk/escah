 "key28": {
  "ja": "四道封者の一。",
  "zh": ""
 },
 "key29": {
  "ja": "頭領不在の殲・上弦衆を弁舌と実力で乗っ取り、",
  "zh": ""
 },
 "key30": {
  "ja": "端的に欲望を満たすための組織として生まれ変わらせた。",
  "zh": ""
 },
 "key31": {
  "ja": "ノロイは利用するつもりであり、忠誠心などはない。",
  "zh": ""
 },
