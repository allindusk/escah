  "zh": ""
 },
 "key33": {
  "ja": "ゲームにおいて  ",
  "zh": ""
 },
 "key34": {
  "ja": "ゲームにおいての役割、使い勝手などの評価をレビューする項目です",
  "zh": ""
 },
 "key35": {
  "ja": "関連キャラクター  ",
  "zh": ""
 },
 "key36": {
  "ja": "四道封者\n",
  "zh": ""
 },
 "key37": {
  "ja": "黒門天・屍寺炎斎",
  "zh": ""
