 "key146": {
  "ja": "大陸の魔女組織「ガンダーラ」からダイビートに派遣されてきた魔女。\n",
  "zh": "从大陆魔女组织\"犍陀罗\"派往戴比特的魔女。"
 },
 "key147": {
  "ja": "ガンダーラはこれまでほぼ外部との接触を持たず箱船のヴィクトリア派がわずかに繋がりを持っていたのみである。",
  "zh": "犍陀罗至今几乎不与外部接触，仅与箱舟的维多利亚派略有联系。"
 },
 "key148": {
  "ja": "保有する魔女因子は西遊記の孫悟空に由来している。",
  "zh": "保有的魔女因子源自西游记的孙悟空。"
 },
 "key149": {
  "ja": "Dチャージの真相を知った際にトキサダに激しい突っ込みを入れる等、この世界では数少ない常識的感覚を持った人物である。",
  "zh": "得知D充能真相时对时香田猛烈吐槽等，是在此世界中少有的拥有常识感的人物。"
 },
